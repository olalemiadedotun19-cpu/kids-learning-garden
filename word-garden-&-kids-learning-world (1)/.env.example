# ElevenLabs API Key for advanced text-to-speech voices
# Get your key from: https://elevenlabs.io/app/api-keys
# This is used for Bella, George, and other premium voices
ELEVENLABS_API_KEY=sk_your_key_here

# Browser-side ElevenLabs fallback (for static deployments without server)
VITE_ELEVENLABS_API_KEY=sk_your_key_here

# Gemini API Key (optional, for advanced AI features)
GEMINI_API_KEY=your_gemini_key_here
